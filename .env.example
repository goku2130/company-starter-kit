# ═══════════════════════════════════════════════════════════════════
# Company Starter Kit — Environment Variables
# Copy to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════════════

# Neon database (per-company)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/company_db?sslmode=require

# YoctoCorp Pay SDK
YOCTO_PAY_API_KEY=yk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOCTO_PAY_BASE_URL=https://yoctocorp.com/api/app-payments

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxx

# SSO from YoctoCorp (shared secret for JWT verification)
YOCTO_SSO_SECRET=

# Site URL (used for canonical links, OG tags)
NEXT_PUBLIC_SITE_URL=https://cashpulse.yocto.com
